# LLM provider: "gemini" or "custom" (auto-detected if unset)
LLM_PROVIDER=custom
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Custom HTTP LLM endpoints (comma-separated, used when LLM_PROVIDER=custom)
# CUSTOM_LLM_ENDPOINTS=https://your-endpoint/gpt
CUSTOM_LLM_ENDPOINTS=https://temp.aistoryteller.workers.dev/gpt,https://temp.hridya.workers.dev/gpt,https://temp.aistoryteller.workers.dev/gpt

# Sarvam STT — enables the push-to-talk voice mode
SARVAM_API_KEY="sk_924m6yhy_ZaP348aPLzj41yOZLBvGKQu2"
SARVAM_STT_MODEL=saarika:v2.5
